@* Họ và tên: Nguỵ Thế Toàn *@
@* Mã sinh viên: 23203100050 *@
@* Nội dung thực hiện: các trang của trang admin *@
@model IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI05_DHTI17A2ND.Models.ViewModels.ThongKeHocPhiTheoKhoaHocVM>

@{
    ViewData["Title"] = "Thống Kê Học Phí Theo Khóa Học";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary"><i class="bi bi-bank"></i> Tổng Học Phí Thu Được Theo Khóa Học</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại Menu Thống Kê</a>
    </div>

    <div class="alert alert-primary">
        <i class="bi bi-check-circle-fill"></i> Báo cáo doanh thu khóa học <strong>chỉ tính từ các đơn đăng ký đã 'Đã xác nhận'</strong>.
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;" class="text-center">STT</th>
                    <th>Tên Khóa Học</th>
                    <th class="text-end">Tổng Doanh Thu</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">Chưa có dữ liệu doanh thu.</td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@(stt++)</td>
                            <td><strong>@item.TenKhoaHoc</strong></td>
                            <td class="text-end text-primary fw-bold fs-6">@item.TongHocPhi.ToString("N0") đ</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>