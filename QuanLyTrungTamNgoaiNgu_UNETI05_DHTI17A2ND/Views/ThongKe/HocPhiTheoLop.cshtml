@* Họ và tên: Nguỵ Thế Toàn *@
@* Mã sinh viên: 23203100050 *@
@* Nội dung thực hiện: các trang của trang admin *@
@model IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI05_DHTI17A2ND.Models.ViewModels.ThongKeHocPhiTheoLopVM>

@{
    ViewData["Title"] = "Thống Kê Học Phí Theo Lớp";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success"><i class="bi bi-cash-stack"></i> Tổng Học Phí Thu Được Theo Lớp</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại Menu Thống Kê</a>
    </div>

    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"></i> Báo cáo này <strong>chỉ tính các đơn đăng ký ở trạng thái 'Đã xác nhận'</strong>.
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;" class="text-center">STT</th>
                    <th>Tên Lớp Học</th>
                    <th>Tên Khóa Học</th>
                    <th class="text-end">Tổng Học Phí</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">Chưa có dữ liệu học phí.</td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@(stt++)</td>
                            <td><strong>@item.TenLop</strong></td>
                            <td>@item.TenKhoaHoc</td>
                            <td class="text-end text-success fw-bold fs-6">@item.TongHocPhi.ToString("N0") đ</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>