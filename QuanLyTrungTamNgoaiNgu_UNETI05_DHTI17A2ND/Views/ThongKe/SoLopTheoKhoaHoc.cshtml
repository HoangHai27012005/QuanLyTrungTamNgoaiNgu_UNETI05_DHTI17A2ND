@* Họ và tên: Nguỵ Thế Toàn *@
@* Mã sinh viên: 23203100050 *@
@* Nội dung thực hiện: các trang của trang admin *@
@model IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI05_DHTI17A2ND.Models.ViewModels.ThongKeLopTheoKhoaHocVM>

@{
    ViewData["Title"] = "Thống Kê Số Lớp Theo Khóa Học";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary"><i class="bi bi-journal-bookmark-fill"></i> Thống Kê Số Lớp Theo Khóa Học</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại Menu Thống Kê</a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark text-center">
                <tr>
                    <th style="width: 80px;">STT</th>
                    <th>Tên Khóa Học</th>
                    <th>Số Lớp Học</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">Chưa có dữ liệu thống kê.</td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var item in Model)
                    {
                        <tr class="text-center">
                            <td>@(stt++)</td>
                            <td class="text-start"><strong>@item.TenKhoaHoc</strong></td>
                            <td><span class="badge bg-primary fs-6">@item.SoLop</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>