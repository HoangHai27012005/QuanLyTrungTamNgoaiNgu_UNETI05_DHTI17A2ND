@* Họ và tên: Nguỵ Thế Toàn *@
@* Mã sinh viên: 23203100050 *@
@* Nội dung thực hiện: các trang của trang admin *@
@model IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI05_DHTI17A2ND.Models.ViewModels.ThongKeTheoTrangThaiVM>

@{
    ViewData["Title"] = "Thống Kê Đăng Ký Theo Trạng Thái";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-warning"><i class="bi bi-pie-chart-fill"></i> Thống Kê Đăng Ký Theo Trạng Thái</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại Menu Thống Kê</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Trạng Thái Xử Lý</th>
                            <th>Số Lượng Lượt Đăng Ký</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted">Chưa có dữ liệu đăng ký nào.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr class="text-center">
                                    <td>
                                        @if (item.TrangThai == "Đã xác nhận")
                                        {
                                            <span class="badge bg-success fs-6">@item.TrangThai</span>
                                        }
                                        else if (item.TrangThai == "Chờ xác nhận")
                                        {
                                            <span class="badge bg-warning text-dark fs-6">@item.TrangThai</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td><strong class="fs-5">@item.SoLuong</strong></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>