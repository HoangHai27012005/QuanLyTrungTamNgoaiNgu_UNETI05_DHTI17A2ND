@* Họ và tên: Ngụy Thế Toàn *@
@* Mã sinh viên: 2320310050 *@
@* Nội dung thực hiện: Thống kê số đăng ký theo trạng thái *@
@using QuanLyTrungTamNgoaiNgu_UNETI05_DHTI17A2ND.Models.ViewModels
@model List<ThongKeDangKyTheoTrangThaiVM>
@{
    ViewData["Title"] = "Số đăng ký theo trạng thái";
    int tong = Model.Sum(x => x.SoLuong);
}

<h2 class="mb-3">Số đăng ký theo từng trạng thái</h2>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr><th>Trạng thái</th><th class="text-end">Số lượng</th><th class="text-end">Tỷ lệ</th></tr>
    </thead>
    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td><partial name="_TrangThaiDangKyBadge" model="x.TrangThai" /></td>
                <td class="text-end">@x.SoLuong</td>
                <td class="text-end">@((tong == 0 ? 0 : x.SoLuong * 100.0 / tong).ToString("0.#")) %</td>
            </tr>
        }
    </tbody>
    <tfoot class="table-light">
        <tr><th>Tổng</th><th class="text-end">@tong</th><th></th></tr>
    </tfoot>
</table>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>