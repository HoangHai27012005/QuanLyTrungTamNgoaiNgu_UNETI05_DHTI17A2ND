@model KhoaHoc

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="TenKhoaHoc" class="form-label"></label>
        <input asp-for="TenKhoaHoc" class="form-control" />
        <span asp-validation-for="TenKhoaHoc" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="TrangThai" class="form-label">Trạng thái</label>
        <select asp-for="TrangThai" class="form-select">
            <option value="true">Đang mở</option>
            <option value="false">Tạm đóng</option>
        </select>
        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="NgoaiNgu" class="form-label"></label>
        <input asp-for="NgoaiNgu" class="form-control" list="dsNgoaiNgu" />
        <datalist id="dsNgoaiNgu">
            <option value="Tiếng Anh"></option>
            <option value="Tiếng Nhật"></option>
            <option value="Tiếng Hàn"></option>
            <option value="Tiếng Trung"></option>
            <option value="Tiếng Pháp"></option>
        </datalist>
        <span asp-validation-for="NgoaiNgu" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="CapDo" class="form-label"></label>
        <input asp-for="CapDo" class="form-control" />
        <span asp-validation-for="CapDo" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="SoBuoi" class="form-label"></label>
        <input asp-for="SoBuoi" class="form-control" />
        <span asp-validation-for="SoBuoi" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="HocPhi" class="form-label"></label>
    <div class="input-group">
        <input asp-for="HocPhi" class="form-control" />
        <span class="input-group-text">đ</span>
    </div>
    <span asp-validation-for="HocPhi" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="MoTa" class="form-label"></label>
    <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
    <span asp-validation-for="MoTa" class="text-danger"></span>
</div>